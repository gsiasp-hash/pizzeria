# Copia este archivo como .env (o .env.local) para desarrollo local.
# En Vercel, esta variable se configura en Project Settings > Environment Variables.
# NO debe incluir la barra final "/" ni el "/api".

# URL base del backend (sin slash final)
# Local:      http://localhost:5000
# Producción: https://<tu-servicio>.onrender.com
VITE_API_URL=http://localhost:5000
