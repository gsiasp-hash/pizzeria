# Copia este archivo como .env para desarrollo local y completa los valores.
# En Render, estas variables se configuran en Dashboard > tu servicio > Environment.
# NUNCA commitear el archivo .env real.

# Secreto usado para firmar los JWT. Genera uno propio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Puerto en el que corre el servidor (Render lo asigna solo, pero se puede fijar en local)
PORT=5000

# URL(es) del frontend permitidas por CORS, separadas por coma.
# Ej: https://pizzeria-frontend.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173
